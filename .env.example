# ============================================================
# Tayf Studio — environment template.
# Copy to `.env` and adjust locally. NEVER commit the real .env.
# NEVER put real API keys in source code or in this file.
# ============================================================

# --- Application ---
APP_ENV=development            # development | test | production
HOST=127.0.0.1                 # local default; set 0.0.0.0 only behind a trusted network/proxy
PORT=8000

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite default = Termux-friendly; PostgreSQL-ready) ---
DATABASE_URL=sqlite:///./tayf.db
DB_ECHO=false

# --- Auth (Argon2id + JWT) ---
# REQUIRED in production. Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=120
JWT_REFRESH_EXPIRES_DAYS=30

# --- Rate limiting (in-memory sliding window, per client IP) ---
RATELIMIT_ENABLED=true
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_AUTH_LIMIT=10        # register/login/refresh attempts per window
RATELIMIT_JOB_LIMIT=30         # generation jobs per window
# Only these peers may set X-Forwarded-For (IPs or CIDRs, comma-separated).
# Default = loopback only. Empty = ignore the header entirely. Add your reverse
# proxy's IP/CIDR here; trusting an arbitrary peer lets clients bypass limits.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Job execution ---
# false = pipeline runs inside the API process (dev/tests, BackgroundTasks).
# true  = jobs stay PENDING until `python -m app.worker` claims them (durable).
EXTERNAL_JOB_WORKER=false
JOB_LEASE_SECONDS=600           # worker renews every 1/3 of this
JOB_POLL_SECONDS=2              # idle delay between queue polls

# --- Artifact URL signing (local storage) ---
# false = /api/v1/files/* URLs require a short-lived HMAC signature (secure
# default). true = serve artifacts to anyone holding the URL (public demos).
FILES_PUBLIC=false

# --- Observability ---
METRICS_ENABLED=true           # exposes GET /api/v1/metrics (aggregate counters)

# --- AI provider: mock | zai_gateway | openai_compatible | replicate_t2v ---
# mock              = offline simulation, clearly labeled SIMULATED (no keys needed)
# zai_gateway       = REAL LLM storyboard + REAL keyframes via the ./ai-gateway sidecar
# openai_compatible = any OpenAI-compatible API with YOUR OWN key
# replicate_t2v     = REAL LLM storyboard + NATIVE text-to-video via Replicate
AI_PROVIDER=mock
AI_GATEWAY_URL=http://127.0.0.1:3030
# REQUIRED when the gateway binds a non-loopback interface (Docker sets 0.0.0.0).
AI_GATEWAY_TOKEN=
AI_GATEWAY_TIMEOUT=240

# Bring-your-own-key option (AI_PROVIDER=openai_compatible)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Native text-to-video (AI_PROVIDER=replicate_t2v), YOUR OWN Replicate token
REPLICATE_API_TOKEN=
REPLICATE_STORYBOARD_MODEL=meta/meta-llama-3.1-8b-instruct
REPLICATE_T2V_MODEL=minimax/h3-highspeed
# Empty = official model endpoint. For versioned models set either the full
# 64-char version hash or a short hash appended to REPLICATE_T2V_MODEL.
REPLICATE_T2V_VERSION=
REPLICATE_POLL_SECONDS=2
REPLICATE_PREDICTION_TIMEOUT=900
REPLICATE_MAX_VIDEO_BYTES=209715200

# --- Storage: local | s3 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
STORAGE_TTL_DAYS=7
CLEANUP_INTERVAL_MINUTES=60

# S3-compatible option (MinIO locally, AWS/R2/DO remotely) — requires
# `pip install -r backend/requirements-s3.txt`
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Credits ---
SIGNUP_CREDITS=100
CREDIT_PER_SCENE=1

# --- Content safety ---
SAFETY_MAX_PROMPT_CHARS=2000
SAFETY_EXTRA_BLOCKED_TERMS=
