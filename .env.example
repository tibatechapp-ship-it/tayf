# ============================================================
# Tayf Studio — environment template.
# Copy to `.env` and adjust locally. NEVER commit the real .env.
# NEVER put real API keys in source code or in this file.
# ============================================================

# --- Application ---
APP_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=8000

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite default = Termux-friendly; PostgreSQL-ready) ---
DATABASE_URL=sqlite:///./tayf.db
DB_ECHO=false

# --- Auth (Argon2id + JWT) ---
# REQUIRED in production. Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=120
JWT_REFRESH_EXPIRES_DAYS=30

# --- Rate limiting (in-memory sliding window, per client IP) ---
RATELIMIT_ENABLED=true
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_AUTH_LIMIT=10        # register/login/refresh attempts per window
RATELIMIT_JOB_LIMIT=30         # generation jobs per window

# --- Artifact URL signing (local storage) ---
# false = /api/v1/files/* URLs require a short-lived HMAC signature (secure
# default). true = serve artifacts to anyone holding the URL (public demos).
FILES_PUBLIC=false

# --- Observability ---
METRICS_ENABLED=true           # exposes GET /api/v1/metrics (aggregate counters)

# --- AI provider: mock | zai_gateway | openai_compatible ---
# mock              = offline simulation, clearly labeled SIMULATED (no keys needed)
# zai_gateway       = REAL LLM storyboard + REAL keyframes via the ./ai-gateway sidecar
# openai_compatible = any OpenAI-compatible API with YOUR OWN key
AI_PROVIDER=mock
AI_GATEWAY_URL=http://127.0.0.1:3030
AI_GATEWAY_TOKEN=
AI_GATEWAY_TIMEOUT=240

# Bring-your-own-key option (AI_PROVIDER=openai_compatible)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Storage: local | s3 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
STORAGE_TTL_DAYS=7
CLEANUP_INTERVAL_MINUTES=60

# S3-compatible option (MinIO locally, AWS/R2/DO remotely) — requires
# `pip install -r backend/requirements-s3.txt`
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Credits ---
SIGNUP_CREDITS=100
CREDIT_PER_SCENE=1

# --- Content safety ---
SAFETY_MAX_PROMPT_CHARS=2000
SAFETY_EXTRA_BLOCKED_TERMS=
