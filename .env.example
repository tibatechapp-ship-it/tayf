# ---- Backend ----
APP_NAME=tayf-backend
ENVIRONMENT=development          # development | test | production
API_V1_PREFIX=/api/v1
# JSON array. Dev defaults are the Vite dev server origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Database ----
# Dev default: SQLite (no server needed on a phone).
# Everything is declared with portable SQLAlchemy types (Uuid, JSON, Enum->VARCHAR+CHECK),
# so switching to Postgres is a URL change + `alembic upgrade head`.
DATABASE_URL=sqlite:///./tayf.db
# Production target:
# DATABASE_URL=postgresql+psycopg://tayf:change-me@localhost:5432/tayf

# ---- Auth (Stage 5 — not wired yet) ----
# JWT_SECRET=replace-with-32-bytes-of-random
# ARGON2_TIME_COST=3

# ---- Redis / background jobs (Stage 8 — not wired yet) ----
# REDIS_URL=redis://localhost:6379/0

# ---- Object storage (Stage 7/8 — not wired yet) ----
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=tayf
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- AI providers (Stage 7 — no provider integrated yet) ----
# Never put a real key here; this file is a template.
# PROVIDER_MODE=mock                # mock is development-only, never production
# PROVIDER_API_KEY=
